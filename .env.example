# Mireye API token. Create one at https://www.mireye.com (account settings).
# The field catalog and the /compare demo need no token; /ask and /fetch do.
MIREYE_API_KEY=

# Only needed for the LLM judge and the no-Mireye baseline.
# The deterministic checks (selection, uncertainty, correctness) run without it:
#   python3 run.py --no-judge
ANTHROPIC_API_KEY=
